rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function team(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    // The signed-in person coaches team t, and an admin has approved that team.
    function isCoach(t) { return signedIn() && team(t).coach == request.auth.uid && team(t).status == "approved"; }
    // The coach accepted this athlete onto team t, and the athlete said yes to posting to Rankings.
    function sharesWith(t, uid) {
      let m = get(/databases/$(database)/documents/teams/$(t)/members/$(uid)).data;
      return m.status == "accepted" && m.share == true;
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Text someone else will see: a string no longer than n.
    function str(d, k, n) { return d[k] is string && d[k].size() <= n; }
    function optStr(d, k, n) { return !(k in d) || str(d, k, n); }

    // Each athlete's own data: only they can read or write it.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if isMe(uid);
    }
    // Submissions for Rankings: athletes can only submit their own, and only as "pending".
    match /subs/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // Only the fields Lane 4 sends, short text, and a results link that is a web address (never javascript: and the like).
      allow create, update: if (isMe(uid) && request.resource.data.status == "pending"
          && request.resource.data.keys().hasOnly(["public", "status", "name", "school", "grad", "state", "gender", "link", "events", "proof", "via", "submittedAt"])
          && str(request.resource.data, "name", 100) && optStr(request.resource.data, "school", 120) && optStr(request.resource.data, "state", 20)
          && (!("link" in request.resource.data) || request.resource.data.link == ""
              || (str(request.resource.data, "link", 500) && request.resource.data.link.matches("https?://[^ <>]+")))
          && (!("events" in request.resource.data) || request.resource.data.events is map))
        || isAdmin();
      allow delete: if isMe(uid) || isAdmin();
    }
    // Verified Rankings: every signed-in athlete can read; admins can write.
    // Coaches of admin-approved teams can also post official results, only for athletes on their own roster who said yes.
    match /board/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow create, update: if request.resource.data.team is string
        && isCoach(request.resource.data.team) && sharesWith(request.resource.data.team, uid)
        && request.resource.data.keys().hasOnly(["name", "school", "grad", "state", "gender", "events", "team", "approvedAt"])
        && str(request.resource.data, "name", 100) && request.resource.data.events is map;
    }
    // "Hide me from Rankings" switches.
    match /optout/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }
    // Teams: anyone signed in can look up one team by its code. Only admins can list them all or approve one.
    match /teams/{t} {
      allow get: if signedIn();
      allow list: if isAdmin();
      // Team codes are 6 letters and numbers made by Lane 4, so a code can never carry anything else onto admin screens.
      allow create: if signedIn() && request.resource.data.coach == request.auth.uid && request.resource.data.status == "pending"
        && t.matches("[A-HJ-NP-Z2-9]{6}")
        && request.resource.data.keys().hasOnly(["name", "school", "state", "coachName", "role", "proof", "coach", "status", "createdAt"])
        && str(request.resource.data, "name", 120) && str(request.resource.data, "school", 120) && optStr(request.resource.data, "state", 20)
        && str(request.resource.data, "coachName", 100) && optStr(request.resource.data, "role", 80) && str(request.resource.data, "proof", 500);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.coach == request.auth.uid);
      // Athletes ask to join an approved team as "pending". Only the coach (or an admin) accepts them.
      match /members/{uid} {
        allow get: if isMe(uid) || isCoach(t) || isAdmin();
        allow list: if isCoach(t) || isAdmin();
        allow create: if isMe(uid) && request.resource.data.status == "pending" && team(t).status == "approved"
          && request.resource.data.keys().hasOnly(["name", "full", "grad", "gender", "share", "status", "added", "joinedAt"])
          && str(request.resource.data, "name", 100) && optStr(request.resource.data, "full", 100)
          && request.resource.data.share is bool && (!("added" in request.resource.data) || request.resource.data.added.size() == 0);
        allow update: if (isMe(uid) && onlyChanges(["share", "added", "name", "full"]))
          || (isCoach(t) && onlyChanges(["status", "added"])) || isAdmin();
        allow delete: if isMe(uid) || isCoach(t) || isAdmin();
      }
    }
    // Admin list: managed only in the Firebase console.
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }
    // Shared workouts: anyone can read them. Signed-in athletes can share their own (small, checked fields only)
    // and change or delete only their own. Admins can remove any.
    match /pubwk/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.by == request.auth.uid
        && (resource == null || resource.data.by == request.auth.uid)
        && request.resource.data.keys().hasOnly(["name", "type", "g", "ph", "parts", "cue", "by", "at"])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.parts is list && request.resource.data.parts.size() <= 8
        && (!("cue" in request.resource.data) || (request.resource.data.cue is string && request.resource.data.cue.size() <= 200));
      allow delete: if (signedIn() && resource.data.by == request.auth.uid) || isAdmin();
    }
    // Feature switches: anyone can read them, only admins can change them.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
